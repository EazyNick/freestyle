IMAGE_ROOT=img
TARGET_FOLDER=roll
CLICK_ALL_FOLDERS=false
LOOP_FOREVER=true

# name: filename order, modified: modified-time order
ORDER_MODE=name
IMAGE_EXTENSIONS=png,jpg,jpeg,bmp

# Seconds to wait before starting
START_DELAY=3

# Image match confidence. Try 0.80-0.95.
CONFIDENCE=0.85

# Seconds to search for each image before moving on
RETRY_SECONDS=5
SEARCH_ATTEMPTS_PER_IMAGE=1

# Seconds to wait between clicks
CLICK_INTERVAL=2
MOVE_DURATION=0.1
MOUSE_PARK_X=1000
MOUSE_PARK_Y=500
MOUSE_WIGGLE_PIXELS=1
SCREEN_REFRESH_DELAY=0.05
PYAUTOGUI_PAUSE=0.05

# true logs matches without actually clicking
DRY_RUN=false

# Move the mouse to a screen corner to stop
FAILSAFE=true

# Console logs are also written here
LOG_FILE=automation.log
